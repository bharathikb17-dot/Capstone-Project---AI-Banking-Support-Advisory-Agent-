# ---- LLM Provider Configuration ----
# The app runs in OFFLINE (deterministic mock) mode if no key is present,
# so every phase is demonstrable without spending credits.

# OpenAI (default provider used by the LangChain integration)
OPENAI_API_KEY=

# Model names (override if you like)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional: Azure OpenAI (set USE_AZURE=1 to enable)
USE_AZURE=0
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=
